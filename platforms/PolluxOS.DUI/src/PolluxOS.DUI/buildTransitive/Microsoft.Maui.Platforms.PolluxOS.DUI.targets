<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Ships with the PolluxOS.DUI backend package.

    The managed assemblies are platform-neutral; the native bridge is not. It is built
    per host by scripts/build-dui.sh + scripts/build-native.sh, which stage the result in
    one platform-neutral folder (<product>/artifacts/native by default):

      FreeBSD/polluxos  libdui_shim.so   (DUI Wayland backend, bmake)
      macOS             libdui_shim.dylib (DUI AppKit backend)
      Linux/Windows     libdui_shim.so / .dll as DUI's X11/Wayland/Win32 backends build

    Point the app at a staged directory to have the files copied to its output:

      dotnet build -p:PolluxOSDuiNativeDir=/path/to/artifacts/native

    Nothing here fails the build when the native library is absent: a managed build
    without the bridge is valid (the bridge is needed to run, not to compile).
  -->
  <PropertyGroup>
    <PolluxOSDuiNativeDir Condition="'$(PolluxOSDuiNativeDir)' == ''"></PolluxOSDuiNativeDir>
    <PolluxOSDuiCopyNative Condition="'$(PolluxOSDuiCopyNative)' == ''">true</PolluxOSDuiCopyNative>
  </PropertyGroup>

  <ItemGroup Condition="'$(PolluxOSDuiCopyNative)' == 'true' and '$(PolluxOSDuiNativeDir)' != '' and Exists('$(PolluxOSDuiNativeDir)')">
    <None Include="$(PolluxOSDuiNativeDir)/*.so"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)" />
    <None Include="$(PolluxOSDuiNativeDir)/*.dylib"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)" />
    <None Include="$(PolluxOSDuiNativeDir)/*.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
