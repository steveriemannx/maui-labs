<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Platform-neutral on purpose: DUI provides the windowing/rendering, so the backend
      has no dependency on a platform SDK TFM. This is what lets the same assembly run
      on polluxos/FreeBSD (and macOS) with the platform's own libdui_shim, and it mirrors
      how the working Avalonia MAUI backend targets FreeBSD (net10.0 + MAUI from NuGet).
    -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Microsoft.Maui.Platforms.PolluxOS.DUI</RootNamespace>
    <AssemblyName>Microsoft.Maui.Platforms.PolluxOS.DUI</AssemblyName>
    <PackageId>Microsoft.Maui.Platforms.PolluxOS.DUI</PackageId>
    <Version>$(PlatformMauiPolluxOSDuiVersion)</Version>
    <Description>A .NET MAUI backend that renders through the DUI toolkit (XML-driven layout + Skia). Platform-neutral, so the same assemblies run on polluxos/FreeBSD, macOS and Linux — only the native bridge is per-host.</Description>
    <PackageTags>maui;polluxos;dui;skia;desktop;dotnet;cross-platform</PackageTags>
    <IsPackable>true</IsPackable>
    <IsShipping>true</IsShipping>
    <!-- LibraryImport-generated P/Invoke helpers are emitted as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.Maui.Platforms.PolluxOS.DUI.Essentials" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <!-- Linker descriptor: preserve all public API types for AOT/trimming -->
  <ItemGroup>
    <EmbeddedResource Include="ILLink.Descriptors.xml">
      <LogicalName>ILLink.Descriptors.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/**" Pack="true" PackagePath="buildTransitive/" />
    <None Include="buildTransitive/**" Pack="true" PackagePath="build/" />
  </ItemGroup>

</Project>
