<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Platform-neutral, like the backend: the same app runs on polluxos/FreeBSD, macOS
         or Linux — only the native bridge (libdui_shim.*) is per-host. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>PolluxOSDuiApp</RootNamespace>
    <AssemblyName>PolluxOSDuiApp</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PolluxOSDuiNativeDir Condition="'$(PolluxOSDuiNativeDir)' == ''">$(MSBuildThisFileDirectory)artifacts/native</PolluxOSDuiNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="__MAUI_VERSION__" />
    <PackageReference Include="Microsoft.Maui.Platforms.PolluxOS.DUI" Version="__DUI_VERSION__" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(PolluxOSDuiNativeDir)')">
    <None Include="$(PolluxOSDuiNativeDir)/*.so" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <None Include="$(PolluxOSDuiNativeDir)/*.dylib" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <None Include="$(PolluxOSDuiNativeDir)/*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
