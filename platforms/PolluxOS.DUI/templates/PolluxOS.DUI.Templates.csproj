<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Microsoft.Maui.Platforms.PolluxOS.DUI.Templates</PackageId>
    <Version>$(PlatformMauiPolluxOSDuiVersion)</Version>
    <Authors>Microsoft</Authors>
    <Description>Project templates for .NET MAUI apps rendered with the DUI toolkit.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>dotnet-new;templates;maui;polluxos;dui</PackageTags>
    <PackageProjectUrl>https://github.com/dotnet/maui-labs/tree/main/platforms/PolluxOS.DUI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dotnet/maui-labs.git</RepositoryUrl>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <IsPackable>true</IsPackable>
    <IsShipping>true</IsShipping>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
    <Content Include="polluxos-dui-app\**\*" Exclude="polluxos-dui-app\**\bin\**;polluxos-dui-app\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

  <Target Name="PreparePolluxOSDuiTemplate" BeforeTargets="_GetPackageFiles">
    <Error Condition="'$(PackageVersion)' == '' or '$(MauiVersion)' == ''"
           Text="PolluxOS.DUI template packaging requires PackageVersion and MauiVersion." />
    <PropertyGroup>
      <_DuiTemplateProject>$(IntermediateOutputPath)templates\polluxos-dui-app\PolluxOSDuiApp.csproj</_DuiTemplateProject>
      <_DuiTemplateContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\polluxos-dui-app\PolluxOSDuiApp.csproj'))</_DuiTemplateContent>
      <_DuiTemplateContent>$(_DuiTemplateContent.Replace('__DUI_VERSION__', '$(PackageVersion)').Replace('__MAUI_VERSION__', '$(MauiVersion)'))</_DuiTemplateContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(_DuiTemplateProject)" Lines="$(_DuiTemplateContent)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Content Remove="polluxos-dui-app\PolluxOSDuiApp.csproj" />
      <Content Include="$(_DuiTemplateProject)" PackagePath="content\polluxos-dui-app\PolluxOSDuiApp.csproj" />
    </ItemGroup>
  </Target>

</Project>
