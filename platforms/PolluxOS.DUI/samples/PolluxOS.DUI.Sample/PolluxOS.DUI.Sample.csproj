<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PolluxOS.DUI.Sample</RootNamespace>
    <AssemblyName>PolluxOS.DUI.Sample</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsShipping>false</IsShipping>
    <!-- The bridge is loaded by name; a managed build without the dylib is valid. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Maui.Essentials" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PolluxOS.DUI\PolluxOS.DUI.csproj" />
    <ProjectReference Include="..\..\src\PolluxOS.DUI.Essentials\PolluxOS.DUI.Essentials.csproj" />
  </ItemGroup>

  <!-- Native bridge: staged by scripts/build-native-macos.sh -->
  <PropertyGroup>
    <PolluxOSDuiNativeDir Condition="'$(PolluxOSDuiNativeDir)' == ''">$(MSBuildThisFileDirectory)../../artifacts/native/macos</PolluxOSDuiNativeDir>
    <!-- DUI's resources/ (themes, skins, lang). Installed tree first, checkout second. -->
    <PolluxOSDuiResourcesDir Condition="'$(PolluxOSDuiResourcesDir)' == '' and Exists('$(PolluxOSDuiInstallDir)/share/dui/resources')">$(PolluxOSDuiInstallDir)/share/dui/resources</PolluxOSDuiResourcesDir>
    <PolluxOSDuiResourcesDir Condition="'$(PolluxOSDuiResourcesDir)' == ''">$(PolluxOSDuiRoot)/resources</PolluxOSDuiResourcesDir>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(PolluxOSDuiNativeDir)')">
    <None Include="$(PolluxOSDuiNativeDir)/*.dylib"
          CopyToOutputDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Exposed to the app so it can hand DUI its resource root at startup. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PolluxOSDuiResourcesDir</_Parameter1>
      <_Parameter2>$(PolluxOSDuiResourcesDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
