<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Self-contained feeds for this standalone test: the repository's NuGet.config points
    at internal dnceng proxies, which are not reachable from the polluxos/FreeBSD box
    (and are irrelevant for a plain SDK project). <clear /> drops the inherited sources.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
